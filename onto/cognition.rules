@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix dul: <http://www.loa-cnr.it/ontologies/DUL.owl#>
@prefix soho: <http://pst.istc.cnr.it/ontologies/2019/01/soho#>
@prefix mc: <http://pst.istc.cnr.it/ontologies/2025/dfki/metacog#>

# Include RDFS rules
@include <RDFS> .

# The capabilities of an embodiment are inherited by its parts
[rule0:
    (?o1 dul:hasPart ?o2),
    (?o2 dul:hasPart ?o3),
    ->
    (?o1 dul:hasPart ?o3)
]

[rule1:
    (?e rdf:type mc:RobotEmbodiment), 
    (?e dul:hasPart ?p), 
    (?p dul:hasQuality ?q),
    -> 
    (?e dul:hasQuality ?q)
]


# infer the functions an embodiment can perform according to its qualities
[rule2:
    (?a rdf:type mc:EmbodiedAgent),
    (?a dul:hasConstituent ?e),
    (?e rdf:type mc:RobotEmbodiment), 
    (?e dul:hasQuality ?q), 
    (?c rdf:type mc:NavigationCapability),
    (?l rdf:type mc:EnvironmentLocation),
    (?l dul:hasQuality mc:TraversabilityDisposition), 
    makeTemp(?x)
    -> 
    (?x rdf:type mc:MoveTo), 
    (?x soho:canBePerformedBy ?a),
    (?x soho:hasTarget ?l)
]
