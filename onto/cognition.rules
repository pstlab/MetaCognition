@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix dul: <http://www.loa-cnr.it/ontologies/DUL.owl#>
@prefix soho: <http://pst.istc.cnr.it/ontologies/2019/01/soho#>
@prefix mc: <http://pst.istc.cnr.it/ontologies/2026/metacognition#>

# Include RDFS rules
@include <RDFS> .

# The capabilities of an embodiment are inherited by its parts
[rule0:
    (?o1 dul:hasPart ?o2),
    (?o2 dul:hasPart ?o3),
    ->
    (?o1 dul:hasPart ?o3)
]

[rule1:
    (?e rdf:type mc:RobotEmbodiment), 
    (?e dul:hasPart ?p), 
    (?p dul:hasQuality ?q),
    -> 
    (?e dul:hasQuality ?q)
]

# Infer a contextual MoveTo for each directed connection between navigation
# locations. The Function changes the Pose of the embodiment's designated
# part bearing the navigation-reference role; it does not modify the factual
# Pose assertion.
[rule-moveto:
    (?a dul:hasConstituent ?e), (?e rdf:type mc:RobotEmbodiment),

    (?e dul:hasQuality ?c), (?c rdf:type mc:NavigationCapability),
    (?e dul:hasPart ?b), (?b rdf:type mc:RobotPart),
    (?b dul:hasRole ?navigationRole),
    (?navigationRole rdf:type mc:NavigationReferencePart),
    (?b dul:hasQuality ?bp), (?bp rdf:type mc:Pose),

    (?ls rdf:type mc:NavigationLocation),
    (?ls dul:hasQuality ?ds), (?ds rdf:type mc:ReachabilityDisposition),
    (?ds mc:connects ?ld), (?ld rdf:type mc:NavigationLocation),
    (?ls dul:hasQuality ?ps), (?ps rdf:type mc:Pose), (?ps dul:hasRegion ?rs),
    (?ld dul:hasQuality ?pd), (?pd rdf:type mc:Pose), (?pd dul:hasRegion ?rd),

    makeTemp(?m),
    makeTemp(?g),
    makeTemp(?f)

    ->

    (?m rdf:type mc:MoveTo), 

    (?m soho:canBePerformedBy ?a),
    (?m soho:hasTarget ?e),
    (?m soho:requiresCapability ?c),

    (?m mc:hasPreconditionOn ?bp),
    (?m soho:hasEffectOn ?bp),

    (?m mc:requiresAlignment ?g),
    (?g rdf:type mc:RegionGuardAlignment),
    (?g mc:concernsObject ?b),
    (?g mc:concernsQuality ?bp),
    (?g mc:hasBeliefAlignmentValue ?rs),

    (?m mc:assertsAlignment ?f),
    (?f rdf:type mc:RegionChangeAlignment),
    (?f mc:concernsObject ?b),
    (?f mc:concernsQuality ?bp),
    (?f mc:hasInitialValue ?rs),
    (?f mc:hasResultingValue ?rd)
]

# Infer a contextual PickGraspable for every object connected by a navigation
# location's reachability disposition. The navigation-reference pose guards the robot's
# location, while the grasping-reference pose is bound to the object pose after
# picking. The rule does not change the factual ABox.
[rule-pickgraspable:
    (?a dul:hasConstituent ?e), (?e rdf:type mc:RobotEmbodiment),

    (?e dul:hasPart ?gripper), (?gripper rdf:type mc:RobotPart),
    (?gripper dul:hasRole ?graspingRole),
    (?graspingRole rdf:type mc:GraspingReferencePart),
    (?gripper dul:hasQuality ?g), (?g rdf:type soho:GraspObjectCapability),
    (?gripper dul:hasQuality ?gp), (?gp rdf:type mc:Pose),

    (?e dul:hasPart ?navigationPart), (?navigationPart rdf:type mc:RobotPart),
    (?navigationPart dul:hasRole ?navigationRole),
    (?navigationRole rdf:type mc:NavigationReferencePart),
    (?navigationPart dul:hasQuality ?n), (?n rdf:type mc:NavigationCapability),
    (?navigationPart dul:hasQuality ?np), (?np rdf:type mc:Pose),

    (?l rdf:type mc:NavigationLocation),
    (?l dul:hasQuality ?r), (?r rdf:type mc:ReachabilityDisposition),
    (?r mc:connects ?o), (?o rdf:type mc:InteractingObject),

    (?l dul:hasQuality ?lp), (?lp rdf:type mc:Pose), (?lp dul:hasRegion ?lr),
    (?o dul:hasQuality ?op), (?op rdf:type mc:Pose), (?op dul:hasRegion ?or),

    makeTemp(?p),
    makeTemp(?guard),
    makeTemp(?binding),
    makeTemp(?change),
    makeTemp(?reachability)

    ->

    (?p rdf:type mc:PickGraspable),
    (?p soho:canBePerformedBy ?a),
    (?p soho:hasTarget ?o),
    (?p mc:hasPreconditionOn ?np),
    (?p mc:hasPreconditionOn ?op),
    (?p soho:hasEffectOn ?op),

    (?p mc:requiresAlignment ?guard),
    (?guard rdf:type mc:RegionGuardAlignment),
    (?guard mc:concernsObject ?navigationPart),
    (?guard mc:concernsQuality ?np),
    (?guard mc:hasBeliefAlignmentValue ?lr),

    (?p mc:assertsAlignment ?binding),
    (?binding rdf:type mc:QualityBindingAlignment),
    (?binding mc:concernsObject ?gripper),
    (?binding mc:concernsObject ?o),
    (?binding mc:concernsQuality ?gp),
    (?binding mc:concernsQuality ?op),
    (?binding mc:hasBeliefAlignmentValue ?lr),

    (?p mc:assertsAlignment ?change),
    (?change rdf:type mc:RegionChangeAlignment),
    (?change mc:concernsObject ?o),
    (?change mc:concernsQuality ?op),
    (?change mc:hasInitialValue ?or),
    (?change mc:hasResultingValue ?lr),

    (?p mc:negatesAlignment ?reachability),
    (?reachability rdf:type mc:ConnectAssertionAlignment),
    (?reachability mc:concernsQuality ?r),
    (?reachability mc:concernsObject ?o)
]

# Infer a contextual PlaceGraspable for each explicitly modeled manipulation
# location connected from a navigation location. The navigation-reference pose
# guards the robot location, the existing gripper/object binding is required and
# then removed, the object
# pose changes to the manipulation-location region, and the source navigation
# disposition becomes connected to the placed object. No factual triple is changed.
[rule-placegraspable:
    (?a dul:hasConstituent ?e), (?e rdf:type mc:RobotEmbodiment),

    (?e dul:hasPart ?gripper), (?gripper rdf:type mc:RobotPart),
    (?gripper dul:hasRole ?graspingRole),
    (?graspingRole rdf:type mc:GraspingReferencePart),
    (?gripper dul:hasQuality ?g), (?g rdf:type soho:GraspObjectCapability),
    (?gripper dul:hasQuality ?gp), (?gp rdf:type mc:Pose),

    (?e dul:hasPart ?navigationPart), (?navigationPart rdf:type mc:RobotPart),
    (?navigationPart dul:hasRole ?navigationRole),
    (?navigationRole rdf:type mc:NavigationReferencePart),
    (?navigationPart dul:hasQuality ?n), (?n rdf:type mc:NavigationCapability),
    (?navigationPart dul:hasQuality ?np), (?np rdf:type mc:Pose),

    (?l rdf:type mc:NavigationLocation),
    (?l dul:hasQuality ?r), (?r rdf:type mc:ReachabilityDisposition),
    (?r mc:connects ?destination), (?destination rdf:type mc:ManipulationLocation),
    (?destination dul:hasQuality ?destinationPose),
    (?destinationPose rdf:type mc:Pose), (?destinationPose dul:hasRegion ?destinationRegion),
    (?l dul:hasQuality ?sourcePose), (?sourcePose rdf:type mc:Pose),
    (?sourcePose dul:hasRegion ?sourceRegion),

    (?o rdf:type mc:InteractingObject),
    (?o dul:hasQuality ?op), (?op rdf:type mc:Pose), (?op dul:hasRegion ?or),

    notEqual(?or, ?destinationRegion),

    makeTemp(?p),
    makeTemp(?guard),
    makeTemp(?binding),
    makeTemp(?change),
    makeTemp(?reachability)

    ->

    (?p rdf:type mc:PlaceGraspable),
    (?p soho:canBePerformedBy ?a),
    (?p soho:hasTarget ?o),
    (?p mc:hasPreconditionOn ?np),
    (?p mc:hasPreconditionOn ?op),
    (?p soho:hasEffectOn ?op),

    (?p mc:requiresAlignment ?guard),
    (?guard rdf:type mc:RegionGuardAlignment),
    (?guard mc:concernsObject ?navigationPart),
    (?guard mc:concernsQuality ?np),
    (?guard mc:hasBeliefAlignmentValue ?sourceRegion),

    (?p mc:requiresAlignment ?binding),
    (?p mc:negatesAlignment ?binding),
    (?binding rdf:type mc:QualityBindingAlignment),
    (?binding mc:concernsObject ?gripper),
    (?binding mc:concernsObject ?o),
    (?binding mc:concernsQuality ?gp),
    (?binding mc:concernsQuality ?op),
    (?binding mc:hasBeliefAlignmentValue ?sourceRegion),

    (?p mc:assertsAlignment ?change),
    (?change rdf:type mc:RegionChangeAlignment),
    (?change mc:concernsObject ?o),
    (?change mc:concernsQuality ?op),
    (?change mc:hasInitialValue ?or),
    (?change mc:hasResultingValue ?destinationRegion),

    (?p mc:assertsAlignment ?reachability),
    (?reachability rdf:type mc:ConnectAssertionAlignment),
    (?reachability mc:concernsQuality ?r),
    (?reachability mc:concernsObject ?o)
]
